# Line ends that must not follow the checkout's core.autocrlf (Git for Windows defaults it to true):
# the hooks run in sh, which reads "\r" as part of the line - LF on every system
.githooks/* text eol=lf
# cmd.exe wants CRLF in a batch file: kept as committed (CRLF), never converted
*.cmd -text
# Corpus identity is verified across Windows and Unix checkouts.
tools/tts-corpus.txt text eol=lf
